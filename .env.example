# SupportPilot Environment Variables
# Copy this file to .env and fill in your values

# LLM API Keys
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Application Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database
DATABASE_URL=sqlite:///./supportpilot.db

# Backend URL (used by frontend)
BACKEND_URL=http://localhost:8000

# Flask
FLASK_SECRET_KEY=your-flask-secret-key-change-this

# LLM Configuration
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# RAG Configuration
FAISS_INDEX_PATH=backend/rag/faiss_index.index
FAISS_METADATA_PATH=backend/rag/faiss_metadata.pkl
DOCS_PATH=docs/
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5
